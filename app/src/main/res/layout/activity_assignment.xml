<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Page title -->

    <TextView
        android:id="@+id/tvAssignmentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Assignments Due"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search icon -->

    <TextView
        android:id="@+id/tvSearchIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:padding="10dp"
        android:text="🔍"
        android:textSize="24sp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAssignmentTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvAssignmentTitle" />

    <!-- Search box (hidden until the icon is tapped) -->

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:hint="Search course"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:padding="14dp"
        android:background="@drawable/bg_rounded_button"
        android:saveEnabled="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAssignmentTitle" />

    <!-- Empty state message -->

    <TextView
        android:id="@+id/tvNoAssignments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No assignments yet.&#10;Tap + to add one."
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp" />

    <!-- Scrollable list of assignment cards -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/etSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:id="@+id/llAssignmentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Floating + button -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddAssignment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Add Assignment"
        android:src="@android:drawable/ic_input_add"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>