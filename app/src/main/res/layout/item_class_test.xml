<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_assignment_card"
    android:padding="16dp"
    android:layout_marginBottom="14dp">

    <TextView
        android:id="@+id/tvTestCourseCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CSE 1203"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvTestClose"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTestClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✕"
        android:textSize="18sp"
        android:textColor="#888888"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTestDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Test: Sep 30, 2026"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTestCourseCode" />

    <TextView
        android:id="@+id/tvTestDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTestDate" />

    <TextView
        android:id="@+id/tvTestAttachment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="📎 View Attachment"
        android:textSize="14sp"
        android:textColor="#1565C0"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTestDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>